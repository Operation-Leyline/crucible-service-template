// The service model, in Crucible's modelling language (crucible/docs/idl).
// Members are required unless marked `name?:`. Operations attach to the
// resource with a role verb, and URI labels bind input members by name.

service MyService {
    version "1"
    protocol json
    resources [Item]
    errors [ValidationException, InternalServerException, UnknownOperationException]
}

// A resource declares what it is: its identifier and properties. Inputs and
// views bind them with `$name`, and the compiler checks each binding.
resource Item {
    id itemId: ItemId
    property name: ItemName
    property notes?: ItemDescription
}

string ItemId {
    length 36..36
    pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
}

string ItemName {
    length 1..100
    pattern "^.*\\S.*$"
}

string ItemDescription { length ..1000 }

string ClientToken {
    length 1..128
    pattern "^[!-~]+$"
}

// Sealed by the framework's page tokens: room for a composite database key.
string NextToken { length 1..1024 }

// A view of Item: each `$` member takes its type and presence from the resource.
structure ItemDetails for Item {
    $itemId
    $name
    $notes
}

list ItemList: ItemDetails

/// Creates an item; retries with the same token and fields return the original result for 24 hours.
operation CreateItem creates Item {
    http POST "/items" -> 201

    input {
        $name
        $notes?
        @token
        clientToken?: ClientToken
    }

    output {
        item: ItemDetails
    }

    errors [ServiceQuotaExceededException]
}

/// Retrieves an item by its immutable identifier.
operation GetItem reads Item {
    http GET "/items/{itemId}"

    input {
        $itemId
    }

    output {
        item: ItemDetails
    }

    errors [ResourceNotFoundException]
}

/// Replaces the editable fields; omitting notes clears them.
idempotent operation UpdateItem updates Item {
    http PUT "/items/{itemId}"

    input {
        $itemId
        $name
        $notes?
    }

    output {
        item: ItemDetails
    }

    errors [ResourceNotFoundException]
}

/// Deletes an item; an already absent item also succeeds.
operation DeleteItem deletes Item {
    http DELETE "/items/{itemId}" -> 204

    input {
        $itemId
    }
}

/// Lists items in identifier order with sealed pagination tokens.
operation ListItems lists Item {
    http GET "/items"
    paginated(inputToken: nextToken, outputToken: nextToken, pageSize: maxResults, items: items)

    input {
        @query
        nextToken?: NextToken
        @query
        maxResults: integer { range 1..100 }
    }

    output {
        items: ItemList
        nextToken?: NextToken
    }
}

enum ResourceType {
    ITEM = "Item"
}

/// The requested item does not exist.
error ResourceNotFoundException {
    status 404
    message: string
    resourceId: ItemId
    resourceType: ResourceType
}

/// The in-memory item limit was reached.
error ServiceQuotaExceededException {
    status 402
    message: string
    resourceType: ResourceType
}
