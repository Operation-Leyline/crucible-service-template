// The service model, in Crucible's modelling language (crucible/docs/idl).
// Members are required unless marked `name?:`. Operations attach to the
// resource with a role verb, and URI labels bind input members by name.

service MyService {
    version "1"
    protocol json
    resources [Item]
    errors [ValidationException, InternalServerException, UnknownOperationException]
}

resource Item {
    id itemId: ItemId
}

string ItemId {
    length 36..36
    pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
}

string ItemName {
    length 1..100
    pattern "^.*\\S.*$"
}

string ItemDescription { length ..1000 }

string ClientToken {
    length 1..128
    pattern "^[!-~]+$"
}

string NextToken { length 1..64 }

structure ItemDetails {
    itemId: ItemId
    name: ItemName
    description?: ItemDescription
}

list ItemList: ItemDetails

/// Creates an item; retries with the same token and fields return the original result for eight hours.
operation CreateItem creates Item {
    http POST "/items" -> 201

    input {
        name: ItemName
        description?: ItemDescription
        @token
        clientToken?: ClientToken
    }

    output {
        item: ItemDetails
    }

    errors [ConflictException, ServiceQuotaExceededException]
}

/// Retrieves an item by its immutable identifier.
operation GetItem reads Item {
    http GET "/items/{itemId}"

    input {
        $itemId
    }

    output {
        item: ItemDetails
    }

    errors [ResourceNotFoundException]
}

/// Replaces the editable fields; omitting description clears it.
operation UpdateItem updates Item {
    http PUT "/items/{itemId}"

    input {
        $itemId
        name: ItemName
        description?: ItemDescription
    }

    output {
        item: ItemDetails
    }

    errors [ResourceNotFoundException]
}

/// Deletes an item; an already absent item also succeeds.
operation DeleteItem deletes Item {
    http DELETE "/items/{itemId}" -> 204

    input {
        $itemId
    }
}

/// Lists items in identifier order with opaque pagination tokens.
operation ListItems lists Item {
    http GET "/items"
    paginated(inputToken: nextToken, outputToken: nextToken, pageSize: maxResults, items: items)

    input {
        @query
        nextToken?: NextToken
        @query
        maxResults?: integer { range 1..100 }
    }

    output {
        items: ItemList
        nextToken?: NextToken
    }
}

enum ResourceType {
    ITEM = "Item"
}

/// The requested item does not exist.
error ResourceNotFoundException {
    status 404
    message: string
    resourceId: ItemId
    resourceType: ResourceType
}

/// A client token was reused with different item fields.
error ConflictException {
    status 409
    message: string
    resourceId: ItemId
    resourceType: ResourceType
}

/// The in-memory item or create-receipt limit was reached.
error ServiceQuotaExceededException {
    status 402
    message: string
    resourceType: ResourceType
}
